      "isDeleted": false,
      "boundElements": [],
      "updated": 1787147720239,
      "link": null,
      "locked": false,
      "text": "- user logs in, sees table with quiz sessions\nwhich he fetches\nThese don't need to have responses in them\nsince they're not needed on the table\n\n- user opens a session, he should fetch responses\nfor that session\nIn those responses user has all data for that\nquiz session\n\nNOTE:\n\nuser info will be sent in QuizSessionLiteDto and QuizSessionDto\nfor now. Reason is that admin should see all quiz session in the table\nand users that created them. Later on this should be redone to have\neither separate endpoint or trim user property if user sending the\nrequest is not admin",
      "fontSize": 23.825682248296314,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- user logs in, sees table with quiz sessions\nwhich he fetches\nThese don't need to have responses in them\nsince they're not needed on the table\n\n- user opens a session, he should fetch responses\nfor that session\nIn those responses user has all data for that\nquiz session\n\nNOTE:\n\nuser info will be sent in QuizSessionLiteDto and QuizSessionDto\nfor now. Reason is that admin should see all quiz session in the table\nand users that created them. Later on this should be redone to have\neither separate endpoint or trim user property if user sending the\nrequest is not admin",
      "autoResize": true,
      "lineHeight": 1.25
    },
