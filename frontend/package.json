		"@tanstack/devtools-vite": "latest",
		"@tanstack/router-cli": "^1.132.0",
		"@types/node": "^22.10.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"cross-env": "^10.1.0",
		"typescript": "^6.0.2",
		"vite": "^8.0.0"
	},
	"pnpm": {
