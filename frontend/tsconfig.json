{
	"include": [
		"**/*.ts",
		"**/*.tsx"
	],
	"compilerOptions": {
		"target": "ES2022",
		"jsx": "react-jsx",
		"module": "ESNext",
		"paths": {
			"@/*": [
				"./src/*",
			],
			"@/api-models/*": [
				"./src/common/generated/models/*"
			],
			"@/models/*": [
				"./src/common/types/*",
				"./src/common/interfaces/*",
				"./src/common/enums/*",
				"./src/common/constants/*"
			],
			"@/shared/*": [
				"./src/shared/*"
			]
		},
		"lib": [
			"ES2022",
			"DOM",
			"DOM.Iterable"
		],
		"types": [
			"vite/client"
		],
		/* Bundler mode */
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		/* Linting */
		"skipLibCheck": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": true
	}
}